##1. Create the Collection with a Schema Validator

db.createCollection("memories", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["_id", "type", "title", "content", "inferred", "source", "derived_from", "status", "owner", "created_at", "ingested_at", "embedding"],
      properties: {
        _id: { bsonType: "string", description: "SHA-256 hex hash" },
        type: { enum: ["hypothesis", "run", "synthesis", "dataset", "code", "note"] },
        title: { bsonType: "string" },
        content: { bsonType: "string" },
        hypothesis: { bsonType: ["string", "null"] },
        inferred: { bsonType: "bool" },
        config: { bsonType: ["object", "null"] },
        key_metrics: { bsonType: ["object", "null"] },
        outcome: { enum: ["worked", "failed", "inconclusive", null] },
        source: {
          bsonType: "object",
          required: ["repo", "path", "commit_sha", "permalink"],
          properties: {
            repo: { bsonType: "string" },
            path: { bsonType: "string" },
            commit_sha: { bsonType: "string" },
            permalink: { bsonType: "string" }
          }
        },
        derived_from: { bsonType: "array", items: { bsonType: "string" } },
        status: { enum: ["draft", "active", "suspect", "retracted", "superseded"] },
        status_reason: { bsonType: ["string", "null"] },
        superseded_by: { bsonType: ["string", "null"] },
        owner: { bsonType: "string" },
        created_at: { bsonType: "date" },
        ingested_at: { bsonType: "date" },
        expires_at: { bsonType: ["date", "null"] },
        embedding: { bsonType: "array", items: { bsonType: "double" } }
      }
    }
  }
})

##2. Create Indexes

// Unique index on _id (auto-created, but explicit for clarity)
db.memories.createIndex({ _id: 1 }, { unique: true })

// B-tree for derived_from graph lookups
db.memories.createIndex({ derived_from: 1 }, { name: "idx_derived_from" })

// TTL index — only expires note-type documents
db.memories.createIndex(
  { expires_at: 1 },
  { expireAfterSeconds: 0, partialFilterExpression: { type: "note" }, name: "idx_expires_at" }
)

