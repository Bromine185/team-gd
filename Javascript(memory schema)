##3. Idempotent Insert (Ingestion)

const _id = crypto.createHash('sha256')
  .update(`${source.repo}${source.path}${source.commit_sha}${type}`)
  .digest('hex')

try {
  db.memories.insertOne({ _id, /* ... rest of doc ... */ })
} catch (err) {
  if (err.code === 11000) {
    // Duplicate — already ingested, skip silently
    console.log(`Memory ${_id} already exists, skipping.`)
  } else {
    throw err
  }
}

##4. Retraction Cascade (Mark Downstream as Suspect)

// Step 1: Mark the target as retracted
db.memories.updateOne(
  { _id: retractedMemoryId },
  { $set: { status: "retracted", status_reason: "User retracted" } }
)

// Step 2: Recursively mark all memories that derived from it as suspect
const cascadePipeline = [
  {
    $graphLookup: {
      from: "memories",
      startWith: "$derived_from",
      connectFromField: "_id",
      connectToField: "derived_from",
      as: "transitive_upstream",
      depthField: "depth",
      restrictSearchWithMatch: { status: { $in: ["active", "suspect"] } }
    }
  },
  { $match: { "transitive_upstream._id": retractedMemoryId } },
  { $project: { _id: 1 } }
]

const downstreamIds = db.memories.aggregate(cascadePipeline).toArray().map(d => d._id)

db.memories.updateMany(
  { _id: { $in: downstreamIds }, status: { $ne: "retracted" } },
  { $set: { status: "suspect", status_reason: `Downstream of retracted memory ${retractedMemoryId}` } }
)

##5. Supersede (Replace Without Overwrite)

const newMemory = { /* ... new version of the memory ... */ }
newMemory.status = "active"

try {
  db.memories.insertOne(newMemory)
  // Mark the old one as superseded
  db.memories.updateOne(
    { _id: oldMemoryId },
    { $set: { status: "superseded", superseded_by: newMemory._id, status_reason: "Superseded by new version" } }
  )
} catch (err) {
  // handle
}

